SC_rain_ts <- xts(data_SC_rain[,-1], order.by=data_SC_rain[,1])
colnames(SC_rain_ts) <- c('SC_rain')

################################################################################
ts = merge(strflow_ts, SC_ts, SC_rain_ts)
